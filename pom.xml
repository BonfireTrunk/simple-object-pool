<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>today.bonfire.oss</groupId>
        <artifactId>bonfire-oss-parent</artifactId>
        <version>2.0.0</version>
    </parent>

    <artifactId>simple-object-pool</artifactId>
    <version>3.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <module.name>bonfire.oss.sop</module.name>
    </properties>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>A lightweight, thread-safe object pooling library for Java applications.
        Features:
        - Thread-safe object pooling with lock-free idle queue and no factory I/O under locks
        - Configurable pool size with min and max limits
        - Automatic idle object eviction
        - Optional abandoned object detection (off by default)
        - Support for object validation and health checks
        - Simple and intuitive API
        - Zero external dependencies (except SLF4J for logging)
        - Try-with-resources leases and functional borrow helpers
        - Java 21+ compatible

        Perfect for managing expensive resources like database connections, network sockets, or any reusable objects.
        (can be used for jedis, redisson, etc.)
    </description>
    <url>https://github.com/BonfireTrunk/simple-object-pool</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Bonfire Team</name>
            <email>oss@bonfire.today</email>
            <organization>Bonfire</organization>
            <organizationUrl>https://github.com/BonfireTrunk</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/BonfireTrunk/simple-object-pool.git</connection>
        <developerConnection>scm:git:ssh://github.com/BonfireTrunk/simple-object-pool.git</developerConnection>
        <url>https://github.com/BonfireTrunk/simple-object-pool</url>
        <tag>HEAD</tag>
    </scm>

    <dependencyManagement>
        <dependencies>
        </dependencies>
    </dependencyManagement>

    <dependencies>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- Tests compile as a patch of the library module, which does not read jdk.jfr.
                                 The pinning guard test records JFR events, so let test code see it. -->
                            <compilerArgs combine.children="append">
                                <arg>--add-modules</arg>
                                <arg>jdk.jfr</arg>
                                <arg>--add-reads</arg>
                                <arg>${module.name}=jdk.jfr</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>performance</excludedGroups>
                    <!-- Tests live in the same package as the module and use logback internals; run them on the classpath. -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bundle-manifest</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>manifest</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn verify -Pperf runs only the tests tagged "performance" -->
        <profile>
            <id>perf</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludedGroups combine.self="override"></excludedGroups>
                            <groups>performance</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
